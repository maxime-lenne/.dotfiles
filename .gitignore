# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
.output/
.vercel/
.netlify/

# Environment variables. Real values live in .env here, symlinked to
# ~/.env.local — this rule is the ONLY thing keeping it out of a commit, so
# never `git add -f` it. .env.example is the versioned template.
.env
.env.local
.env.*.local
!.env.example

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files
*.tmp
*.swp
*.swo
*~

# TypeScript
*.tsbuildinfo

# Testing
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/

# git worktrees created by Claude Code (EnterWorktree)
.claude/worktrees/

# superpowers SDD workspace (ledger, briefs, review packages)
.superpowers/
