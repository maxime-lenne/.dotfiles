# Template for ~/.env.local — the machine-local secrets file.
#
# The real values live in .env at the root of this repo. .gitignore keeps it
# out of every commit — it is the one dotfile here that is never versioned.
# ~/.env.local is a symlink to it, and shell/index.sh sources that symlink
# last, so anything set there wins over the values shell/exports.sh declares.
#
# Bootstrap on a new machine: ./configure_dotfiles.sh seeds .env from this
# template, chmod 600 it, and links it to ~/.env.local. By hand:
#   cp .env.example .env && chmod 600 .env && ln -s "$PWD/.env" ~/.env.local
#
# Never put a real value in THIS file: it is versioned and published.
#
# This file is a shell fragment sourced by both bash and zsh: plain
# `export KEY="value"` lines, no interpolation surprises.

# ---------------------------------------------------------------------------
# Airmail MCP server
# ---------------------------------------------------------------------------
# Only the token is a secret; the port and the auto-launch flag are plain
# config and live in shell/exports.sh.
#
# Heads-up: these exports reach a shell — terminals, scripts, and any MCP
# server started from a CLI. They do NOT reach Claude Desktop launched from
# the Dock: a macOS GUI app inherits its environment from launchd, not from
# .zshrc. Claude Desktop reads its own claude_desktop_config.json / extension
# settings instead.
export AIRMAIL_MCP_REMEMBER_CLIENT_TOKEN=""

# ---------------------------------------------------------------------------
# GitHub MCP server
# ---------------------------------------------------------------------------
# Personal access token for the `github` MCP server
# (https://api.githubcopilot.com/mcp/). ~/.claude.json holds the server
# definition with "Bearer ${GITHUB_MCP_TOKEN}" as its Authorization header —
# Claude Code expands the variable from the environment at connect time
# (verified 2026-09-16: a wrong value gets a 401, so the expansion is real).
# Before that date the PAT sat in clear in ~/.claude.json.
#
# Same launchd caveat as above: the value reaches a terminal-launched
# `claude`, not one started by a GUI app from the Dock.
export GITHUB_MCP_TOKEN=""
