#!/bin/bash
#
# Runs shellcheck over the shell scripts being committed.
#
# Wired up with `git config core.hooksPath hooks` (configure_dotfiles.sh
# does this). Bypass a single commit with `git commit --no-verify`, and
# override the strictness with SHELLCHECK_SEVERITY=warning git commit.
#
# Written for bash 3.2, the version macOS still ships at /bin/bash.

if ! command -v shellcheck > /dev/null 2>&1; then
  echo "pre-commit: shellcheck not found, skipping the shell lint."
  echo "            install it with: brew install shellcheck"
  exit 0
fi

# info catches the unquoted-expansion class (SC2086) that has already
# bitten install-deps.sh; style is the pedantic tier and stays off.
severity="${SHELLCHECK_SEVERITY:-info}"

files=()
while IFS= read -r -d '' file; do
  case "$file" in
    *.sh)
      files+=("$file")
      ;;
    *)
      # Extensionless scripts, recognised by the shebang of the staged
      # content rather than whatever is in the working tree.
      if git show ":$file" 2>/dev/null | head -n 1 | grep -qE '^#!.*/(env +)?(ba|k|z)?sh\b'; then
        files+=("$file")
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ ${#files[@]} -eq 0 ]; then
  exit 0
fi

# Lint the staged content, not the working tree: a partially staged file
# has to be judged on what is actually going into the commit.
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

for file in "${files[@]}"; do
  mkdir -p "$tmpdir/$(dirname "$file")"
  git show ":$file" > "$tmpdir/$file" || exit 1
done

# Materialise every *other* tracked shell file too, from the index.
# Only the staged ones get linted, but `shellcheck -x` follows `source`
# directives and needs the target on disk: a commit touching only
# clean-mac.sh would otherwise be judged without dotfiles-lib.sh next
# to it and fail on two false positives (SC1091, and SC2034 for the
# AUTO_YES that the library does read). The index holds the current
# content of every tracked file, so this reproduces what the tree looks
# like once the commit lands.
while IFS= read -r -d '' dep; do
  case "$dep" in
    *.sh) ;;
    *) continue ;;
  esac
  [ -e "$tmpdir/$dep" ] && continue
  mkdir -p "$tmpdir/$(dirname "$dep")"
  git show ":$dep" > "$tmpdir/$dep" 2>/dev/null || rm -f "$tmpdir/$dep"
done < <(git ls-files -z)

if (cd "$tmpdir" && shellcheck -x -S "$severity" -- "${files[@]}"); then
  exit 0
fi

echo
echo "pre-commit: shellcheck -S $severity flagged the staged content above."
echo "            fix it, or commit anyway with: git commit --no-verify"
exit 1
